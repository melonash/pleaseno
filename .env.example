# Server-side only. Get one at https://console.typesafe.ai
TYPESAFE_API_KEY=

# Any long random string. Signs the hidden game state so players cannot edit the meter.
# Generate with: openssl rand -hex 32
GAME_STATE_SECRET=

# Optional. When set, each reply is written by Claude Haiku in the character's voice, aware of what the player said.
# When unset, replies come from the authored line bank. Any generation failure also falls back to the bank.
ANTHROPIC_API_KEY=
